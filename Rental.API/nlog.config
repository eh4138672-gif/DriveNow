<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- כל שורה כוללת את ה-CorrelationId של הבקשה (או - כשאין בקשה, למשל בהפעלה) -->
  <variable name="lineLayout"
            value="${longdate} ${level:uppercase=true:padding=-5} [${scopeproperty:CorrelationId:whenEmpty=-}] ${logger:shortName=true} - ${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/rental-${shortdate}.log"
            layout="${lineLayout}"
            encoding="utf-8"
            maxArchiveDays="14" />
    <target xsi:type="Console" name="console" layout="${lineLayout}" />
  </targets>

  <rules>
    <!-- הודעות הפעלה וכיבוי של השרת -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />
    <!-- רעש של המסגרת (כולל כל שאילתת SQL של EF): עוצרים כאן הכול מתחת ל-Warning -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <!-- הרמה המינימלית נקבעת בקונפיגורציה: Debug בפיתוח, Info כברירת מחדל -->
    <logger name="*" minlevel="${configsetting:item=NLog.MinLevel:default=Info}" writeTo="console,file" />
  </rules>
</nlog>
